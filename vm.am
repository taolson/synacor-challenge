|| Synacor challenge virtual machine evaluator


%import <base>
%import <io>                            -(>>=) -(<$>) -(>>)
%import <io>            qualified
%import <lens>
%import <maybe>                         -(>>=) -(<$>) -(>>)
%import <maybeState>    as mst
%import <vector>        as v            -(<$>)
%import "arch"


boolVal :: bool -> int
boolVal False = 0
boolVal True  = 1

|| eval helpers for common patterns
evalRO  op r a   = i16_fmap op <$> readOpr a >>= writeReg r
evalROO op r a b = mst.liftA2 (i16_liftA2 op) (readOpr a) (readOpr b) >>= writeReg r
evalJmp a        = readOpr a >>= setPC where setPC (Int16 a) = mst.set vm_pc a

evalJmpc :: (int -> bool) -> opr -> opr -> maybeState vmSt ()
evalJmpc p a b
    = mst.bind2 (readOpr a) (readOpr b) go
      where
        go (Int16 a) (Int16 b)
            = mst.set vm_pc b, if p a
            = mst.pure (),     otherwise

evalOut :: char -> maybeState vmSt ()
evalOut '\n' = mst.set vm_stat ReqOut    || request output for full line
evalOut c    = mst.over vm_out (c :)     || add char to output queue

evalIn :: reg -> maybeState vmSt ()
evalIn r
    = mst.view vm_inp >>= check
      where
        check [] = mst.over vm_pc (subtract 2) >> mst.set vm_stat ReqIn
        check (c : cs) = writeReg r (Int16 . code $ c) >> mst.set vm_inp cs

step :: maybeState vmSt ()
step
    = decodeInsn >>= eval 
      where
        eval Halt         = mst.set vm_stat Halted
        eval (Set r a)    = evalRO id r a
        eval (Push a)     = readOpr a >>= pushStk
        eval (Pop r)      = popStk >>= writeReg r
        eval (Eq r a b)   = evalROO (\a b -> boolVal $ a == b) r a b
        eval (Gt r a b)   = evalROO (\a b -> boolVal $ a > b)  r a b
        eval (Jmp a)      = evalJmp a
        eval (Jt a b)     = evalJmpc (~= 0) a b
        eval (Jf a b)     = evalJmpc (== 0) a b
        eval (Add r a b)  = evalROO (+) r a b
        eval (Mult r a b) = evalROO (*) r a b
        eval (Mod r a b)  = evalROO mod r a b
        eval (And r a b)  = evalROO (.&.) r a b
        eval (Or r a b)   = evalROO (.|.) r a b
        eval (Not r a)    = evalRO complement r a
        eval (Rmem r a)   = readOpr a >>= readMem >>= writeReg r
        eval (Wmem a x)   = mst.bind2 (readOpr a) (readOpr x) writeMem
        eval (Call a)     = mst.view vm_pc >>= (pushStk . Int16) >> evalJmp a
        eval Ret          = popStk >>= i16_val .> mst.set vm_pc
        eval (Out a)      = readOpc a >>= evalOut
        eval (In r)       = evalIn r
        eval Nop          = mst.pure ()
        eval (Word x)     = mst.fail

runVM, doHalt, doInput, doOutput :: vmSt -> io ()
runVM st
    = case lens.view vm_stat st of
        Running -> case step st of (mr, st') -> fromMaybef (doHalt st') (\_ -> runVM st') mr
        Halted  -> doHalt st
        ReqIn   -> doInput st
        ReqOut  -> doOutput st

doHalt st = putStrLn ("Halted at " ++ showint (lens.view vm_pc st))

doInput st
    = getLine io.>>= checkInput
      where
        checkInput []          = doHalt st
        checkInput ('`' : cmd) = words cmd |> doCmd st
        checkInput s           = lens.set vm_inp (s ++ "\n") st |> lens.set vm_stat Running |> runVM

doOutput st
    = (lens.view vm_out st |> reverse |> putStrLn) io.>>
      (lens.set vm_out [] st |> lens.set vm_stat Running |> runVM)

doCmd :: vmSt -> [string] -> io ()
doCmd st (cmd : args)
    = go cmd $ map numval args
      where
        go "set-register" [r, n] = doInput $ mst.execState (writeReg (Reg r) (Int16 n)) st
        go "set-memory"   [a, n] = doInput $ mst.execState (writeMem (Int16 a) (Int16 n)) st
        go _              _      = error ("doCmd: unrecognized command: " ++ cmd)

doCmd _ _ = error "doCmd: bad command"


main :: io ()
main
    = getArgs io.>>= checkArgs
      where
        mregs      = Int16 0 |> v.rep 8 |> v.unsafeThaw
        initSt mem = (Running, 0, mregs, [], mem, [], [])

        checkArgs [fn] = readFile fn io.>>= (makeMemory .> initSt .> runVM)
        checkArgs _    = errStrLn "usage: vm <synacor binary file name>"
