|| Synacor challenge virtual machine architecture


%export +

%import <base>
%import <either>                -pure -(>>=) -(<$>) -(<<) -(>>) -liftA2
%import <lens>                  -view -over -set
%import <maybe>                 -pure -(>>=) -(<$>) -(<<) -(>>) -(<|>) -liftA2
%import <maybeState>
%import <vector>        as v    -(<$>)


|| instruction set


int16 ::= Int16 int

i16_fmap :: (int -> int) -> int16 -> int16
i16_fmap f (Int16 x) = Int16 $ f x .&. 0x7fff

i16_liftA2 :: (int -> int -> int) -> int16 -> int16 -> int16
i16_liftA2 f (Int16 a) (Int16 b) = Int16 $ f a b .&. 0x7fff


i16_val :: int16 -> int
i16_val (Int16 x) = x

|| make a 16-bit int from two character values (little endian)
makeInt16 :: char -> char -> int16
makeInt16 lo hi = Int16 $ code hi .<<. 8 .|. code lo

printInt16 :: int16 -> string
printInt16 (Int16 n) = showint n

reg ::= Reg int

printReg :: reg -> string
printReg (Reg n) = 'r' : showint n

opr == either reg int16

printOpr :: opr -> string
printOpr (Left r)  = printReg r
printOpr (Right n) = printInt16 n

opc == either reg char

printOpc :: opc -> string
printOpc (Left r)  = printReg r
printOpc (Right c) = showchar c

insn ::=
    Halt                |
    Set reg opr         |
    Push opr            |
    Pop  reg            |
    Eq   reg opr opr    |
    Gt   reg opr opr    |
    Jmp  opr            |
    Jt   opr opr        |
    Jf   opr opr        |
    Add  reg opr opr    |
    Mult reg opr opr    |
    Mod  reg opr opr    |
    And  reg opr opr    |
    Or   reg opr opr    |
    Not  reg opr        |
    Rmem reg opr        |
    Wmem opr opr        |
    Call opr            |
    Ret                 |
    Out  opc            |
    In   reg            |
    Nop                 |
    Word int16                  || a pseudo-insn, not in the instruction set, to designate a data value when disassembling code

padOp :: string -> string
padOp = padR 6

|| printInsn helpers

printROO :: string -> reg -> opr -> opr -> string
printROO op d s1 s2 = padOp op ++ intercalate ", " [printReg d, printOpr s1, printOpr s2]

printRO :: string -> reg -> opr -> string
printRO op d s = padOp op ++ intercalate ", " [printReg d,  printOpr s]

printR :: string -> reg -> string
printR op d = padOp op ++ printReg d

printOO  :: string -> opr -> opr -> string
printOO op s1 s2 = padOp op ++ intercalate ", " [printOpr s1, printOpr s2]

printO  :: string -> opr -> string
printO op s = padOp op ++ printOpr s

printOc :: string -> opc -> string
printOc op s = padOp op ++ printOpc s

printInsn :: insn -> string
printInsn Halt           = "halt"
printInsn (Set d s)      = printRO  "set"  d s
printInsn (Push s)       = printO   "push" s
printInsn (Pop d)        = printR   "pop"  d
printInsn (Eq d s1 s2)   = printROO "eq"   d s1 s2
printInsn (Gt d s1 s2)   = printROO "gt"   d s1 s2
printInsn (Jmp t)        = printO   "jmp"  t
printInsn (Jt s t)       = printOO  "jt"   s t
printInsn (Jf s t)       = printOO  "jf"   s t
printInsn (Add d s1 s2)  = printROO "add"  d s1 s2
printInsn (Mult d s1 s2) = printROO "mult" d s1 s2
printInsn (Mod d s1 s2)  = printROO "mod"  d s1 s2
printInsn (And d s1 s2)  = printROO "and"  d s1 s2
printInsn (Or d s1 s2)   = printROO "or"   d s1 s2
printInsn (Not d s)      = printRO  "not"  d s
printInsn (Rmem d m)     = printRO  "rmem" d m
printInsn (Wmem s m)     = printOO  "wmem" s m
printInsn (Call t)       = printO   "call" t
printInsn Ret            = "ret"
printInsn (Out s)        = printOc  "out"  s
printInsn (In d)         = printR   "in"   d
printInsn Nop            = "nop"
printInsn (Word (Int16 x)) = padOp ".word" ++ showint x


|| vm state

|| execution status
status ::= Running | Halted | ReqIn | ReqOut

cmpstatus = undef       || don't derive cmpstatus because dequeue doesn't export cmp

registers == mvector int16
stack     == [int16]
memory    == mvector int16
vmSt      == (status, int, registers, stack, memory, string, string)    || status, pc, regs, stack, mem, inp, out

cmpvmSt = undef        || don't derive comparison for vmSt, since dequeue doesn't have a comparison exported

|| lenses for vmSt
vm_stat = lensTup7_0
vm_pc   = lensTup7_1
vm_reg  = lensTup7_2
vm_stk  = lensTup7_3
vm_mem  = lensTup7_4
vm_inp  = lensTup7_5
vm_out  = lensTup7_6


|| register operations
readOpr :: opr -> maybeState vmSt int16
readOpr (Left (Reg r)) = view vm_reg >>= \regs -> liftState (unsafeRead regs r)
readOpr (Right n)      = pure n

readOpc :: opc -> maybeState vmSt char
readOpc (Left (Reg r)) = view vm_reg >>= \regs -> liftState (unsafeRead regs r) >>= \(Int16 n) -> pure $ decode n
readOpc (Right c)      = pure c

writeReg :: reg -> int16 -> maybeState vmSt ()
writeReg (Reg r) x = view vm_reg >>= \regs -> liftState (unsafeWrite regs r x)


|| memory operations
readMem :: int16 -> maybeState vmSt int16
readMem (Int16 a) = view vm_mem >>= \mem -> liftState(unsafeRead mem a)

writeMem :: int16 -> int16 -> maybeState vmSt ()
writeMem (Int16 a) x = view vm_mem >>= \mem -> liftState(unsafeWrite mem a x)


|| stack operations
popStk :: maybeState vmSt int16
popStk
    = view vm_stk >>= pop
      where
        pop []       = fail
        pop (x : xs) = set vm_stk xs >> pure x

pushStk :: int16 -> maybeState vmSt ()
pushStk n = over vm_stk (n :)


|| decoding insns from memory

|| fetch a value from memory, incrementing the pc
fetch :: maybeState vmSt int16
fetch
    = bind2 (view vm_mem) (view vm_pc) checkRead
      where checkRead mem pc
        = (liftState $ unsafeRead mem pc) << over vm_pc (+ 1), if pc < mlength mem
        = fail,                                                      otherwise

|| make a reg from an int16
makeReg :: int16 -> maybeState vmSt reg
makeReg (Int16 n)
    = pure . Reg $ (n .&. 7), if 0x8000 <= n < 0x8008
    = fail,                   otherwise

|| decode a reg from memory
decodeReg :: maybeState vmSt reg
decodeReg = fetch >>= makeReg

|| make a char from an int16
makeChar :: int16 -> maybeState vmSt char
makeChar (Int16 n)
    = pure . decode $ n, if 0 <= n < 0x7f
    = fail,              otherwise

|| decode an operand from memory
decodeOpr :: maybeState vmSt opr
decodeOpr = fetch >>= \n -> (Left <$> makeReg n) <|> (Right <$> pure n)

decodeOpc :: maybeState vmSt opc
decodeOpc = fetch >>= \n -> (Left <$> makeReg n) <|> (Right <$> makeChar n)

|| decode helpers
dROO op = liftA3 op decodeReg decodeOpr decodeOpr
dRO  op = liftA2 op decodeReg decodeOpr
dR   op =            op <$> decodeReg
dOO  op = liftA2 op decodeOpr decodeOpr
dO   op =            op <$> decodeOpr
dOc  op =            op <$> decodeOpc

decoders :: vector (maybeState vmSt insn)
decoders = v.fromList [pure Halt, dRO Set, dO Push, dR Pop, dROO Eq, dROO Gt, dO Jmp, dOO Jt, dOO Jf, dROO Add, dROO Mult,
                       dROO Mod, dROO And, dROO Or, dRO Not, dRO Rmem, dOO Wmem, dO Call, pure Ret, dOc Out, dR In, pure Nop]

decodeInsn :: maybeState vmSt insn
decodeInsn
    = fetch >>= check
      where
        check (Int16 n)
            = decoders !! n, if 0 <= n <= 21
            = fail,      otherwise

|| memory is architecturally defined as 32K words, so we allocate all 32K (initialized with 0), then
|| fill from the binary
makeMemory :: string -> memory
makeMemory s
    = unsafeThaw $ initMem // prog
      where
        initMem = Int16 0 |> v.rep 0x8000
        prog    = pairWise s |> map (uncurry makeInt16) |> enumerate

        pairWise (a : b : xs) = (a, b) : pairWise xs
        pairWise _            = []
