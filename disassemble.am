|| Synacor challenge virtual machine disassembler


%import <base>
%import <io>                    -(<$>)
%import <maybe>                 -(>>=) -(<$>) -(<|>)
%import <maybeState>    as mst  -(>>=)
%import "arch"


disassemble :: memory -> [(int, insn)]
disassemble mem
    = mst.evalState go (Halted, 0, undef, undef, mem, undef, undef) |> fromJust
      where
        go = mst.liftA2 (:) decInsnWord (go <|> mst.pure [])

        decInsnWord
            = mst.liftA2 pair (mst.view vm_pc) (decodeInsn <|> (Word <$> fetch))


main :: io ()
main
    = getArgs >>= checkArgs
      where
        checkArgs [fn] = readFile fn >>= go
        checkArgs _ = errStrLn "usage: disassemble <synacor binary file name>"

        printPcInsn (pc, insn)
            = padL 6 (showint pc) ++ ": " ++ printInsn insn

        go = makeMemory .> disassemble .> io.mapM_ (printPcInsn .> putStrLn )
